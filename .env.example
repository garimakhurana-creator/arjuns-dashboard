# LLM for CV extraction, scoring, briefs and email copy.
# Uses Gemini when GEMINI_API_KEY is set; set LLM_PROVIDER=anthropic to use Claude instead.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.1-pro-preview
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5

# Resend (email delivery)
RESEND_API_KEY=
# Must be a domain verified in Resend. onboarding@resend.dev only delivers to your own Resend account email.
RESEND_FROM=Arjun Mehta <arjun@yourdomain.com>
# RESEND_REPLY_TO=arjun@yourdomain.com

# Replaces [Calendly Link] in interview invites
CALENDLY_URL=https://calendly.com/arjun-kargo/45min

# Rejection emails arrive this many hours after they're scheduled
# (Low potential: at evaluation time; passed candidates: when Arjun approves)
REJECTION_DELAY_HOURS=48
# PORT=3500

# Neon Postgres storage. Paste the connection string from the Neon console
# (Connect > Node.js). The table is created automatically on first run.
# Leave blank to store candidates in data/candidates.json instead.
DATABASE_URL=

# Test mode: deliver every email to this address instead of the candidate.
# EMAIL_OVERRIDE_TO=you@example.com
